<file path="src/main/resources/static/admin/css/user-management.css">
:root {
    color-scheme: light;
    --ink: #202c3b;
    --muted: #748094;
    --line: #e5eaf1;
    --surface: #fff;
    --canvas: #f4f7fb;
    --blue: #2864dc;
    --red: #c73b46;
}

* { box-sizing: border-box; }
body { margin: 0; color: var(--ink); font-family: "Nunito", "Segoe UI", sans-serif; }
a { color: var(--blue); text-decoration: none; }
a:hover { text-decoration: underline; }
.admin-page { min-height: 100vh; background: var(--canvas); }
.topbar { min-height: 68px; display: flex; align-items: center; gap: 36px; padding: 0 5vw; background: var(--surface); border-bottom: 1px solid var(--line); }
.topbar .brand { color: var(--ink); font-size: 18px; font-weight: 800; letter-spacing: .06em; white-space: nowrap; }
.brand span { margin-left: 8px; color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: 0; }
.topbar nav { display: flex; align-items: stretch; gap: 24px; flex: 1; height: 68px; }
.topbar nav a { display: inline-flex; align-items: center; color: var(--muted); font-size: 14px; }
.topbar nav a.active { color: var(--blue); border-bottom: 2px solid var(--blue); font-weight: 700; }
.page-container { width: min(1180px, 92vw); margin: 38px auto; }
.narrow-container { width: min(800px, 92vw); }
.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
h1 { margin: 0 0 8px; font-size: clamp(24px, 3vw, 32px); font-weight: 800; }
.eyebrow { margin: 0 0 8px; color: var(--blue); font-size: 11px; font-weight: 800; letter-spacing: .13em; }
.muted, .subtext { color: var(--muted); }
.muted { margin: 0; }
.subtext { display: block; margin-top: 4px; font-size: 12px; }
.panel { padding: 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px rgba(35, 55, 80, .04); }
.search-form { display: flex; gap: 10px; margin-bottom: 20px; }
input { width: 100%; min-height: 42px; padding: 10px 12px; color: var(--ink); background: #fff; border: 1px solid #d7deea; border-radius: 7px; font: inherit; }
input:focus { outline: 3px solid rgba(40, 100, 220, .14); border-color: var(--blue); }
.search-form input { max-width: 420px; }
.button { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; border: 1px solid transparent; border-radius: 7px; cursor: pointer; font: inherit; font-size: 13px; font-weight: 700; white-space: nowrap; }
.button:hover { text-decoration: none; filter: brightness(.97); }
.button.primary { color: white; background: var(--blue); }
.button.secondary { color: #435168; background: white; border-color: #d7deea; }
.button.danger { color: var(--red); background: #fff; border-color: #edcbd0; }
.button.small { min-height: 32px; padding: 5px 9px; font-size: 12px; }
.full-width { width: 100%; margin-top: 20px; }
.table-scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { padding: 13px 12px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: middle; }
th { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }
.actions-heading { text-align: right; }
.actions { display: flex; justify-content: flex-end; align-items: center; gap: 6px; }
.actions form, .topbar form { margin: 0; }
.role-chip, .status { display: inline-flex; padding: 5px 8px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap; }
.role-chip { color: #4d5f7a; background: #eef2f8; }
.status-active { color: #187344; background: #e5f6ed; }
.status-locked { color: #9b343d; background: #fbe9eb; }
.empty-cell { padding: 34px; color: var(--muted); text-align: center; }
.table-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 18px; color: var(--muted); font-size: 13px; }
.pagination { display: flex; gap: 6px; }
.pagination a { min-width: 34px; padding: 7px 9px; text-align: center; border: 1px solid var(--line); border-radius: 6px; }
.pagination a.selected { color: white; background: var(--blue); border-color: var(--blue); }
.notice { margin: 0 0 16px; padding: 12px 14px; border: 1px solid; border-radius: 7px; font-size: 14px; }
.notice p { margin: 0; }
.notice p + p { margin-top: 4px; }
.notice.success { color: #17633e; background: #e8f7ee; border-color: #c3e9d1; }
.notice.error { color: #922f39; background: #fff0f1; border-color: #f0c9cd; }
.form-panel { padding: 28px; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.field { min-width: 0; }
.field-full { grid-column: 1 / -1; }
.field label { display: block; margin-bottom: 7px; font-size: 13px; font-weight: 700; }
.field-error { display: block; min-height: 17px; margin-top: 5px; color: var(--red); font-size: 12px; }
.form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 12px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.auth-page { min-height: 100vh; display: grid; place-items: center; padding: 28px 16px; background: linear-gradient(135deg, #edf3ff, #f7f9fc 60%, #eaf1ff); }
.auth-card { width: min(430px, 100%); padding: 38px; background: white; border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 18px 55px rgba(35, 55, 80, .12); }
.auth-card-wide { width: min(720px, 100%); }
.auth-brand { margin-bottom: 18px; color: var(--blue); font-size: 13px; font-weight: 900; letter-spacing: .16em; }
.auth-card h1 { font-size: 25px; }
.auth-card form { margin-top: 24px; }
.auth-card label { display: block; margin: 15px 0 7px; font-size: 13px; font-weight: 700; }
.auth-footer { margin: 20px 0 0; text-align: center; font-size: 14px; }
.small-text { margin-top: 14px; text-align: center; font-size: 12px; }
.dashboard-welcome { margin: 12px 0 28px; }
.dashboard-welcome h1 span { color: var(--blue); }
.dashboard-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.dashboard-card { display: flex; min-height: 205px; flex-direction: column; align-items: flex-start; gap: 12px; padding: 24px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px rgba(35, 55, 80, .04); }
.dashboard-card:hover { border-color: #b9cbf1; box-shadow: 0 12px 30px rgba(35, 55, 80, .09); text-decoration: none; transform: translateY(-1px); }
.dashboard-icon { color: var(--blue); font-size: 22px; }
.dashboard-card-title { font-size: 17px; font-weight: 800; }
.dashboard-link { margin-top: auto; color: var(--blue); font-size: 13px; font-weight: 800; }
.user-home { padding-top: 48px; padding-bottom: 64px; }
.user-home-card { max-width: 840px; margin: 0 auto; padding: 38px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 10px 30px rgba(35, 55, 80, .06); }
.user-home-card h1 span { color: var(--blue); }
.user-home-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }

@media (max-width: 760px) {
    .topbar { flex-wrap: wrap; gap: 0 18px; padding: 14px 4vw; }
    .topbar nav { order: 3; width: 100%; height: 42px; gap: 20px; }
    .topbar form { margin-left: auto; }
    .page-container { margin-top: 24px; }
    .page-heading { align-items: flex-start; flex-direction: column; }
    .panel { padding: 14px; }
    .search-form { flex-wrap: wrap; }
    .search-form input { max-width: none; flex-basis: 100%; }
    .actions { min-width: 220px; }
    .table-footer { align-items: flex-start; flex-direction: column; }
    .form-grid { grid-template-columns: 1fr; gap: 10px; }
    .field-full { grid-column: auto; }
    .auth-card { padding: 26px 20px; }
    .dashboard-grid { grid-template-columns: 1fr; }
    .user-home-card { padding: 24px 18px; }
}
