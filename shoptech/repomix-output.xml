<file path="src/main/resources/templates/admin/orders.html">
<!doctype html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org" th:replace="~{fragments/admin-layout :: layout('Đơn hàng','orders',~{::main})}"><body><main>
<h1>Quản lý đơn hàng</h1><form method="get" th:action="@{/admin/orders}" class="form-inline mb-3">
<input class="form-control mr-2" name="keyword" th:value="${keyword}" maxlength="100" placeholder="Mã đơn / khách hàng" aria-label="Tìm đơn hàng">
<select class="form-control mr-2" name="status" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option th:each="s : ${statuses}" th:value="${s}" th:text="${s}" th:selected="${s == status}"></option></select><button class="btn btn-primary">Tìm kiếm</button></form>
<p th:if="${orders.empty}">Không có đơn hàng phù hợp.</p><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Người nhận</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>
<tr th:each="order : ${orders}"><td><a th:href="@{/admin/orders/{id}(id=${order.id})}" th:text="${order.code}"></a></td><td th:text="${order.customer}"></td><td th:text="${order.recipientName}"></td><td th:text="${#temporals.format(order.createdAt.atZoneSameInstant(T(java.time.ZoneId).of('Asia/Ho_Chi_Minh')),'dd/MM/yyyy HH:mm')}"></td><td th:text="${#numbers.formatDecimal(order.total,1,'POINT',0,'COMMA')}+' ₫'"></td><td th:text="${order.status}"></td></tr></tbody></table></div>
<nav><a th:if="${orders.hasPrevious()}" th:href="@{/admin/orders(keyword=${keyword},status=${status},page=${orders.number-1})}">Trang trước</a> <span th:text="${orders.number+1}"></span> <a th:if="${orders.hasNext()}" th:href="@{/admin/orders(keyword=${keyword},status=${status},page=${orders.number+1})}">Trang sau</a></nav>
</main></body></html>
</file>

<file path="src/main/resources/templates/admin/register.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng ký | ShopTech</title>
    <link rel="stylesheet" th:href="@{/admin/css/sb-admin-2.min.css}">
    <link rel="stylesheet" th:href="@{/admin/css/user-management.css}">
</head>
<body class="auth-page">
<main class="auth-card auth-card-wide">
    <div class="auth-brand">SHOPTECH</div>
    <h1>Tạo tài khoản</h1>
    <p class="muted">Điền thông tin để đăng ký tài khoản khách hàng.</p>

    <div class="notice error" th:if="${#fields.hasGlobalErrors()}">
        <p th:each="error : ${#fields.globalErrors()}" th:text="${error}"></p>
    </div>
    <form th:action="@{/register}" th:object="${registerForm}" method="post">
        <div class="form-grid">
            <div class="field">
                <label for="fullName">Họ và tên</label>
                <input id="fullName" th:field="*{fullName}" autocomplete="name" required>
                <small class="field-error" th:errors="*{fullName}"></small>
            </div>
            <div class="field">
                <label for="username">Tên đăng nhập</label>
                <input id="username" th:field="*{username}" autocomplete="username" minlength="3" maxlength="50" required>
                <small class="field-error" th:errors="*{username}"></small>
            </div>
            <div class="field">
                <label for="email">Email</label>
                <input id="email" th:field="*{email}" type="email" autocomplete="email" maxlength="100" required>
                <small class="field-error" th:errors="*{email}"></small>
            </div>
            <div class="field">
                <label for="phoneNumber">Số điện thoại</label>
                <input id="phoneNumber" th:field="*{phoneNumber}" type="tel" autocomplete="tel">
                <small class="field-error" th:errors="*{phoneNumber}"></small>
            </div>
            <div class="field field-full">
                <label for="address">Địa chỉ</label>
                <input id="address" th:field="*{address}" autocomplete="street-address" maxlength="255">
                <small class="field-error" th:errors="*{address}"></small>
            </div>
            <div class="field field-full">
                <label for="password">Mật khẩu (ít nhất 6 ký tự)</label>
                <input id="password" th:field="*{password}" type="password" autocomplete="new-password" minlength="6" required>
                <small class="field-error" th:errors="*{password}"></small>
            </div>
        </div>
        <button class="button primary full-width" type="submit">Đăng ký</button>
    </form>
    <p class="auth-footer">Đã có tài khoản? <a th:href="@{/login}">Đăng nhập</a></p>
</main>
</body>
</html>
</file>

