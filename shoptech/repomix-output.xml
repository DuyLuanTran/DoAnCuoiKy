<file path="src/main/resources/templates/admin/login.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập | ShopTech</title>
    <link rel="stylesheet" th:href="@{/admin/css/sb-admin-2.min.css}">
    <link rel="stylesheet" th:href="@{/admin/css/user-management.css}">
</head>
<body class="auth-page">
<main class="auth-card">
    <div class="auth-brand">SHOPTECH</div>
    <h1>Chào mừng trở lại</h1>
    <p class="muted">Đăng nhập bằng tên đăng nhập hoặc email của bạn.</p>

    <div class="notice success" th:if="${param.registered}">Đăng ký thành công. Bạn có thể đăng nhập ngay.</div>
    <div class="notice error" th:if="${param.error}">Thông tin đăng nhập không đúng hoặc tài khoản đang bị khóa.</div>
    <div class="notice success" th:if="${param.logout}">Bạn đã đăng xuất thành công.</div>
    <div class="notice success" th:if="${param.passwordReset}">Đặt lại mật khẩu thành công. Hãy đăng nhập bằng mật khẩu mới.</div>
    <div class="notice error" th:if="${errorMessage}" th:text="${errorMessage}"></div>

    <form th:action="@{/login}" method="post">
        <label for="username">Tên đăng nhập hoặc email</label>
        <input id="username" name="username" type="text" autocomplete="username" required autofocus>

        <label for="password">Mật khẩu</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>

        <button class="button primary full-width" type="submit">Đăng nhập</button>
    </form>
    <p class="auth-footer"><a th:href="@{/forgot-password}">Quên mật khẩu?</a></p>
    <p class="auth-footer">Chưa có tài khoản? <a th:href="@{/register}">Đăng ký</a></p>
</main>
</body>
</html>
</file>

