<!doctype html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Chi tiết đơn hàng | ShopTech</title>
<th:block th:replace="~{fragments/commerce :: head}"/><link rel="stylesheet" th:href="@{/user/css/bootstrap.min.css}"><link rel="stylesheet" th:href="@{/user/css/style.css}"></head>
<body><header id="header"><div class="container"><a th:href="@{/products}" class="logo"><img th:src="@{/user/img/logo.png}" alt="ShopTech"></a></div></header><main class="section container">
<nav th:replace="~{fragments/commerce :: links}"></nav><a th:href="@{/orders}">Lịch sử đơn hàng</a>
<section th:fragment="detail"><h1 th:text="${order.code}"></h1>
<p th:text="'Khách hàng: ' + ${order.customer}"></p>
<p th:text="'Ngày đặt: ' + ${#temporals.format(order.createdAt.atZoneSameInstant(T(java.time.ZoneId).of('Asia/Ho_Chi_Minh')),'dd/MM/yyyy HH:mm')}"></p>
<p>Trạng thái: <strong id="order-status" th:attr="data-order-id=${order.id}" th:text="${order.status}"></strong></p>
<p th:text="${order.recipientName} + ' · ' + ${order.recipientPhone}"></p><p th:text="${order.shippingAddress}"></p><p th:text="${order.note}"></p>
<div class="table-responsive"><table class="table"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>
<tr th:each="item : ${order.items}"><td><img th:if="${item.image != null}" th:src="${item.image}" alt="" width="60" loading="lazy"><span th:text="${item.name}"></span></td><td th:text="${#numbers.formatDecimal(item.price,1,'POINT',0,'COMMA')}+' ₫'"></td><td th:text="${item.quantity}"></td><td th:text="${#numbers.formatDecimal(item.subtotal,1,'POINT',0,'COMMA')}+' ₫'"></td></tr></tbody></table></div>
<p th:text="'Tiền hàng: ' + ${#numbers.formatDecimal(order.subtotal,1,'POINT',0,'COMMA')}+' ₫'"></p><p th:text="'Phí giao hàng: ' + ${#numbers.formatDecimal(order.shippingFee,1,'POINT',0,'COMMA')}+' ₫'"></p>
<h3 th:text="'Tổng tiền: ' + ${#numbers.formatDecimal(order.total,1,'POINT',0,'COMMA')}+' ₫'"></h3><p>Thanh toán: <span th:text="${order.paymentMethod}"></span> · <span th:text="${order.paymentStatus}"></span></p>
</section></main><th:block th:replace="~{fragments/commerce :: scripts}"/></body></html>
</file>

<file path="src/main/resources/templates/user/orders.html">
<!doctype html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Đơn hàng | ShopTech</title>
<th:block th:replace="~{fragments/commerce :: head}"/><link rel="stylesheet" th:href="@{/user/css/bootstrap.min.css}"><link rel="stylesheet" th:href="@{/user/css/style.css}"></head>
<body><header id="header"><div class="container"><a th:href="@{/products}" class="logo"><img th:src="@{/user/img/logo.png}" alt="ShopTech"></a></div></header>
<main class="section container"><nav th:replace="~{fragments/commerce :: links}"></nav><h1>Lịch sử đơn hàng</h1>
<p th:if="${orders.empty}">Chưa có đơn hàng.</p><div class="table-responsive"><table class="table" th:unless="${orders.empty}"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
<tbody><tr th:each="order : ${orders}"><td><a th:href="@{/orders/{id}(id=${order.id})}" th:text="${order.code}"></a></td><td th:text="${#temporals.format(order.createdAt.atZoneSameInstant(T(java.time.ZoneId).of('Asia/Ho_Chi_Minh')), 'dd/MM/yyyy HH:mm')}"></td><td th:text="${#numbers.formatDecimal(order.total,1,'POINT',0,'COMMA')} + ' ₫'"></td><td th:text="${order.status}"></td></tr></tbody></table></div>
<nav><a th:if="${orders.hasPrevious()}" th:href="@{/orders(page=${orders.number-1})}">Trang trước</a> <span th:text="${orders.number+1}"></span> <a th:if="${orders.hasNext()}" th:href="@{/orders(page=${orders.number+1})}">Trang sau</a></nav>
</main><th:block th:replace="~{fragments/commerce :: scripts}"/></body></html>
</file>

<file path="src/main/resources/templates/user/product.html">
<!doctype html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title th:text="${product.name} + ' | ShopTech'">Chi tiết sản phẩm</title>

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Montserrat:400,500,700"
    />

    <link rel="stylesheet" th:href="@{/user/css/bootstrap.min.css}" />
    <link rel="stylesheet" th:href="@{/user/css/slick.css}" />
    <link rel="stylesheet" th:href="@{/user/css/slick-theme.css}" />
    <link rel="stylesheet" th:href="@{/user/css/nouislider.min.css}" />
    <link rel="stylesheet" th:href="@{/user/css/font-awesome.min.css}" />
    <link rel="stylesheet" th:href="@{/user/css/style.css}" />

    <!-- Dùng lại phần xử lý header và chữ dài của trang danh sách -->
    <style th:replace="~{user/store :: style}"></style>

    <style>
      #product-main-img .product-preview img {
        width: 100%;
        height: 400px;
        object-fit: contain;
      }

      #product-imgs .product-preview img {
        width: 100%;
        height: 100px;
        padding: 8px;
        object-fit: contain;
      }

      .product-details .product-name {
        line-height: 1.5;
        overflow-wrap: anywhere;
      }

      .product-details .product-price {
        line-height: 1.5;
      }

      .product-details .product-old-price {
        display: block;
      }

      .product-text {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.8;
      }

      .product-summary {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        line-height: 1.8;
      }

      .product-details .product-links {
        line-height: 1.8;
        overflow-wrap: anywhere;
      }

      .product-details .add-to-cart-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .product-details .add-to-cart .qty-label {
        margin-bottom: 15px;
      }

      .product-details .add-to-cart .input-number input {
        padding-right: 8px;
      }

      @media (max-width: 991px) {
        #product-main-img .product-preview img {
          height: 320px;
        }

        .product-details {
          margin-top: 30px;
        }
      }

      @media (max-width: 767px) {
        #product-main-img .product-preview img {
          height: 260px;
        }

        .product-details .product-name {
          font-size: 21px;
        }
      }
    </style>
  <th:block th:replace="~{fragments/commerce :: head}"/></head>

  <body>
    <!-- Dùng nguyên header và menu của trang danh sách -->
    <header th:replace="~{user/store :: header}"></header>
    <nav th:replace="~{user/store :: #navigation}"></nav>

    <!-- BREADCRUMB -->
    <div id="breadcrumb" class="section">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <ul class="breadcrumb-tree">
              <li>
                <a th:href="@{/products}">Sản phẩm</a>
              </li>
              <li>
                <a
                  th:href="@{/products(
                               categoryId=${product.category.id}
                           )}"
                  th:text="${product.category.name}"
                >
                </a>
              </li>
              <li class="active" th:text="${product.name}"></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION -->
    <div class="section">
      <div class="container">
        <div class="row">
          <!-- Ảnh lớn: giữ vị trí của Electro -->
          <div class="col-md-5 col-md-push-2">
            <div id="product-main-img">
              <div
                class="product-preview"
                th:if="${!#strings.isEmpty(product.mainImage)}"
              >
                <img th:src="${product.mainImage}" th:alt="${product.name}" />
              </div>

              <div
                class="product-preview"
                th:each="imageUrl : ${product.imageGallery}"
                th:if="${!#strings.isEmpty(imageUrl)}"
              >
                <img th:src="${imageUrl}" th:alt="${product.name}" />
              </div>

              <div
                class="product-preview text-center"
                th:if="${#strings.isEmpty(product.mainImage)
                             and #arrays.isEmpty(product.imageGallery)}"
              >
                <p class="text-muted">Chưa có ảnh sản phẩm.</p>
              </div>
            </div>
          </div>

          <!-- Ảnh thu nhỏ -->
          <div class="col-md-2 col-md-pull-5">
            <div id="product-imgs">
              <div
                class="product-preview"
                th:if="${!#strings.isEmpty(product.mainImage)}"
              >
                <img th:src="${product.mainImage}" th:alt="${product.name}" />
              </div>

              <div
                class="product-preview"
                th:each="imageUrl : ${product.imageGallery}"
                th:if="${!#strings.isEmpty(imageUrl)}"
              >
                <img th:src="${imageUrl}" th:alt="${product.name}" />
              </div>
            </div>
          </div>

          <!-- Thông tin sản phẩm -->
          <div class="col-md-5">
            <div class="product-details">
              <h1 class="product-name" th:text="${product.name}"></h1>

              <p class="text-muted" th:if="${!#strings.isEmpty(product.sku)}">
                Mã sản phẩm:
                <strong th:text="${product.sku}"></strong>
              </p>

              <div>
                <h2 class="product-price">
                  <span
                    th:text="${
                                #numbers.formatDecimal(
                                    product.discountPrice != null
                                        ? product.discountPrice
                                        : product.price,
                                    1, 'POINT', 0, 'COMMA'
                                )
                            } + ' ₫'"
                  >
                  </span>

                  <del
                    class="product-old-price"
                    th:if="${product.discountPrice != null}"
                    th:text="${
                                     #numbers.formatDecimal(
                                         product.price,
                                         1, 'POINT', 0, 'COMMA'
                                     )
                                 } + ' ₫'"
                  >
                  </del>
                </h2>

                <p>
                  <span
                    class="product-available"
                    th:text="${product.stockQuantity > 0}
                                      ? 'Còn hàng' : 'Hết hàng'"
                  >
                  </span>
                </p>
              </div>

              <p
                class="product-summary"
                th:if="${!#strings.isEmpty(product.description)}"
                th:text="${product.description}"
              ></p>

              <!-- Thêm sản phẩm qua API giỏ hàng -->
              <div class="add-to-cart">
                <div class="qty-label">
                  <label for="quantity">Số lượng</label>
                  <div class="input-number">
                    <input
                      id="quantity"
                      name="quantity"
                      type="number"
                      value="1"
                      min="1"
                      step="1"
                      th:max="${product.stockQuantity > 0}
                                           ? ${product.stockQuantity} : 1"
                      th:disabled="${product.stockQuantity <= 0}"
                    />
                  </div>
                </div>

                <button
                  class="add-to-cart-btn"
                  type="button"
                  th:disabled="${product.stockQuantity <= 0}" th:attr="data-add-product=${product.id}"
                >
                  <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                  Thêm vào giỏ
                </button>
              </div>

              <ul class="product-links">
                <li>Danh mục:</li>
                <li>
                  <a
                    th:href="@{/products(
                                   categoryId=${product.category.id}
                               )}"
                    th:text="${product.category.name}"
                  >
                  </a>
                </li>
              </ul>

              <ul class="product-links">
                <li>
                  <a th:href="@{/products}">
                    <i class="fa fa-arrow-left" aria-hidden="true"></i>
                    Quay lại danh sách
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <!-- Tab nội dung gốc của Electro -->
          <div class="col-md-12">
            <div id="product-tab">
              <ul class="tab-nav" role="tablist">
                <li class="active" role="presentation">
                  <a
                    data-toggle="tab"
                    href="#description"
                    role="tab"
                    aria-controls="description"
                  >
                    Mô tả sản phẩm
                  </a>
                </li>
                <li role="presentation">
                  <a
                    data-toggle="tab"
                    href="#specifications"
                    role="tab"
                    aria-controls="specifications"
                  >
                    Thông số kỹ thuật
                  </a>
                </li>
              </ul>

              <div class="tab-content">
                <div
                  id="description"
                  class="tab-pane fade in active"
                  role="tabpanel"
                >
                  <div class="row">
                    <div class="col-md-12">
                      <p
                        class="product-text"
                        th:text="${
                                           #strings.isEmpty(product.description)
                                               ? 'Chưa có mô tả sản phẩm.'
                                               : product.description
                                       }"
                      ></p>
                    </div>
                  </div>
                </div>

                <div id="specifications" class="tab-pane fade" role="tabpanel">
                  <div class="row">
                    <div class="col-md-12">
                      <p
                        class="product-text"
                        th:text="${
                                           #strings.isEmpty(product.specifications)
                                               ? 'Chưa có thông số kỹ thuật.'
                                               : product.specifications
                                       }"
                      ></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dùng nguyên footer của trang danh sách -->
    <footer th:replace="~{user/store :: #footer}"></footer>

    <script th:src="@{/user/js/jquery.min.js}"></script>
    <script th:src="@{/user/js/bootstrap.min.js}"></script>
    <script th:src="@{/user/js/slick.min.js}"></script>
    <script th:src="@{/user/js/nouislider.min.js}"></script>
    <script th:src="@{/user/js/jquery.zoom.min.js}"></script>
    <script th:src="@{/user/js/main.js}"></script>
  <th:block th:replace="~{fragments/commerce :: scripts}"/></body>
</html>
</file>

<file path="src/main/resources/templates/user/store.html">
<!DOCTYPE html>
<html lang="vi"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Sản phẩm | ShopTech</title>

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css?family=Montserrat:400,500,700">

    <link rel="stylesheet" th:href="@{/user/css/bootstrap.min.css}">
    <link rel="stylesheet" th:href="@{/user/css/slick.css}">
    <link rel="stylesheet" th:href="@{/user/css/slick-theme.css}">
    <link rel="stylesheet" th:href="@{/user/css/nouislider.min.css}">
    <link rel="stylesheet" th:href="@{/user/css/font-awesome.min.css}">
    <link rel="stylesheet" th:href="@{/user/css/style.css}">

    <!-- Chỉ xử lý chữ dài, form tìm kiếm và kích thước ảnh -->
    <style>
        .header-search form {
            display: flex;
            align-items: stretch;
        }

        #header .header-search form .input-select {
            flex: 0 1 220px;
            width: 220px;
            min-width: 0;
            margin: 0;
        }

        #header .header-search form .input {
            flex: 1 1 0;
            width: 0;
            min-width: 0;
            margin: 0;
        }

        #header .header-search form .search-btn {
            flex: 0 0 100px;
            width: 100px;
            white-space: nowrap;
        }

        .store-logout-form {
            display: inline;
        }

        .store-logout-form button {
            padding: 0;
            border: 0;
            background: transparent;
            color: #fff;
            font-size: 12px;
        }

        .store-logout-form button:hover {
            color: #d10024;
        }

        #navigation .main-nav {
            display: flex;
            flex-wrap: wrap;
            float: none;
        }

        #navigation .main-nav > li {
            float: none;
            margin-left: 0;
            margin-right: 24px;
        }

        #aside .category-link {
            display: block;
            padding: 8px 0;
            overflow-wrap: anywhere;
        }

        #aside .category-link.selected {
            color: #d10024;
            font-weight: 700;
        }

        .product .product-img > a {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 240px;
            padding: 15px;
        }

        .product .product-img > a > img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .product .product-category {
            min-height: 18px;
            overflow-wrap: anywhere;
        }

        .product .product-body .product-name {
            display: -webkit-box;
            height: 44px;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            line-height: 22px;
        }

        .product .product-body .product-price {
            min-height: 48px;
        }

        .product .product-old-price {
            display: block;
            margin-top: 4px;
        }

        .product-stock {
            margin: 12px 0;
            font-size: 12px;
        }

        .store-size-form {
            display: inline-block;
        }

        .store-size-form label {
            margin-right: 8px;
        }

        .store-size-form button {
            height: 40px;
            padding: 0 12px;
            border: 1px solid #e4e7ed;
            background: #fff;
        }

        .store-clear {
            display: inline-block;
            margin-left: 12px;
            color: #d10024;
        }

        .store-search-summary {
            margin-bottom: 20px;
            overflow-wrap: anywhere;
        }

        .footer-links a {
            overflow-wrap: anywhere;
        }

        @media (max-width: 991px) {
            #aside {
                margin-bottom: 25px;
            }
        }

        @media (max-width: 767px) {
            .header-search form {
                flex-wrap: wrap;
                gap: 8px 0;
            }

            #header .header-search form .input-select {
                flex: 0 0 100%;
                width: 100%;
                max-width: 100%;
                border-radius: 20px;
            }

            #header .header-search form .input {
                border-radius: 20px 0 0 20px;
            }

            #navigation .main-nav {
                display: block;
            }

            .product .product-img > a {
                height: 180px;
                padding: 10px;
            }

            .product .product-body {
                padding: 12px 8px;
            }

            .product .product-body .product-price {
                font-size: 16px;
            }

            .store-size-form label {
                display: block;
            }

            .store-clear {
                margin-top: 12px;
                margin-left: 0;
            }
        }
			.header-logo .store-brand {
				display: inline-block;
				padding: 4px 0;
				color: #fff;
				font-size: 42px;
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -1.5px;
				white-space: nowrap;
			}

			.header-logo .store-brand span {
				color: #d10024;
			}

			.header-logo .store-brand:hover,
			.header-logo .store-brand:focus {
				color: #fff;
			}

			.header-ctn > div > a.store-account {
				width: auto;
				min-width: 90px;
				max-width: 160px;
			}

			.store-account > span {
				display: block;
				overflow-wrap: anywhere;
				line-height: 1.5;
			}
    </style>
<th:block th:replace="~{fragments/commerce :: head}"/></head>

<body>
<!-- HEADER -->
<header>
    <div id="top-header">
        <div class="container">
            <ul class="header-links pull-right">
                <li sec:authorize="isAnonymous()">
                    <a th:href="@{/login}">
                        <i class="fa fa-sign-in" aria-hidden="true"></i>
                        Đăng nhập
                    </a>
                </li>

                <li sec:authorize="isAnonymous()">
                    <a th:href="@{/register}">
                        <i class="fa fa-user-plus" aria-hidden="true"></i>
                        Đăng ký
                    </a>
                </li>

                <li sec:authorize="hasRole('ADMIN')">
                    <a th:href="@{/admin}">
                        <i class="fa fa-cog" aria-hidden="true"></i>
                        Quản trị
                    </a>
                </li>

                <li sec:authorize="isAuthenticated()">
                    <form class="store-logout-form"
                          th:action="@{/logout}"
                          method="post">
                        <button type="submit">
                            <i class="fa fa-sign-out" aria-hidden="true"></i>
                            Đăng xuất
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>

    <div id="header">
        <div class="container">
            <div class="row">
                <!-- Thương hiệu -->
                <div class="col-md-3">
                    <div class="header-logo">
                        <a class="logo store-brand"
                           th:href="@{/products}">
                            ShopTech<span>.</span>
                        </a>
                    </div>
                </div>

                <!-- Tìm kiếm -->
                <div class="col-md-6">
                    <div class="header-search">
                        <form th:action="@{/products}" method="get">
                            <select class="input-select"
                                    name="categoryId"
                                    aria-label="Danh mục sản phẩm">
                                <option value="">Tất cả danh mục</option>

                                <option th:each="category : ${categories}"
                                        th:value="${category.id}"
                                        th:text="${category.name}"
                                        th:selected="${category.id == categoryId}">
                                </option>
                            </select>

                            <input class="input"
                                   name="keyword"
                                   type="search"
                                   th:value="${keyword}"
                                   placeholder="Tìm sản phẩm..."
                                   aria-label="Tên sản phẩm">

                            <button class="search-btn" type="submit">
                                Tìm kiếm
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Tài khoản -->
                <div class="col-md-3 clearfix">
                    <div class="header-ctn"><div><a th:href="@{/cart}">Giỏ hàng (<span data-cart-badge th:attr="data-authenticated=${#authorization.expression('isAuthenticated()')}">0</span>)</a></div>
                        <div sec:authorize="isAuthenticated()">
                            <a class="store-account"
                               th:href="@{/account}">
                                <i class="fa fa-user-o" aria-hidden="true"></i>
                                <span sec:authentication="name"></span>
                            </a>
                        </div>

                        <div sec:authorize="isAnonymous()">
                            <a th:href="@{/login}">
                                <i class="fa fa-user-o" aria-hidden="true"></i>
                                <span>Đăng nhập</span>
                            </a>
                        </div>

                        <div class="menu-toggle">
                            <a href="#responsive-nav">
                                <i class="fa fa-bars" aria-hidden="true"></i>
                                <span>Danh mục</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- NAVIGATION -->
<nav id="navigation" aria-label="Điều hướng cửa hàng">
    <div class="container">
        <div id="responsive-nav">
            <ul class="main-nav nav navbar-nav">
                <li th:classappend="${categoryId == null} ? 'active'">
                    <a th:href="@{/products}">Tất cả sản phẩm</a>
                </li>

                <li th:each="category : ${categories}"
                    th:classappend="${category.id == categoryId} ? 'active'">
                    <a th:href="@{/products(categoryId=${category.id})}"
                       th:text="${category.name}">
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <ul class="breadcrumb-tree">
                    <li><a th:href="@{/}">Trang chủ</a></li>
                    <li><a th:href="@{/products}">Sản phẩm</a></li>
                    <li class="active"
                        th:text="${products.totalElements} + ' kết quả'">
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- SECTION -->
<div class="section">
    <div class="container">
        <div class="row">

            <!-- ASIDE -->
            <aside id="aside" class="col-md-3">
                <div class="aside">
                    <h2 class="aside-title">Danh mục</h2>

                    <div class="checkbox-filter">
                        <a class="category-link"
                           th:classappend="${categoryId == null} ? 'selected'"
                           th:href="@{/products(
                               keyword=${keyword},
                               size=${products.size}
                           )}">
                            Tất cả danh mục
                        </a>

                        <a class="category-link"
                           th:each="category : ${categories}"
                           th:classappend="${category.id == categoryId}
                               ? 'selected'"
                           th:href="@{/products(
                               categoryId=${category.id},
                               keyword=${keyword},
                               size=${products.size}
                           )}"
                           th:text="${category.name}">
                        </a>
                    </div>
                </div>
            </aside>

            <!-- STORE -->
            <div id="store" class="col-md-9">

                <!-- Bộ điều khiển danh sách -->
                <div class="store-filter clearfix">
                    <div class="store-sort">
                        <form class="store-size-form"
                              th:action="@{/products}"
                              method="get">
                            <input type="hidden"
                                   name="keyword"
                                   th:value="${keyword}">

                            <input th:if="${categoryId != null}"
                                   type="hidden"
                                   name="categoryId"
                                   th:value="${categoryId}">

                            <label for="pageSize">
                                Sản phẩm mỗi trang:
                                <select class="input-select"
                                        id="pageSize"
                                        name="size">
                                    <option value="12"
                                            th:selected="${products.size == 12}">
                                        12
                                    </option>
                                    <option value="24"
                                            th:selected="${products.size == 24}">
                                        24
                                    </option>
                                    <option value="48"
                                            th:selected="${products.size == 48}">
                                        48
                                    </option>
                                </select>
                            </label>

                            <button type="submit">Áp dụng</button>
                        </form>

                        <a class="store-clear"
                           th:href="@{/products}">
                            Xóa bộ lọc
                        </a>
                    </div>
                </div>

                <p class="store-search-summary">
                    Tìm thấy
                    <strong th:text="${products.totalElements}">0</strong>
                    sản phẩm.
                    <th:block th:if="${!#strings.isEmpty(keyword)}">
                        Từ khóa:
                        <strong th:text="${keyword}"></strong>
                    </th:block>
                </p>

                <div class="alert alert-info"
                     role="status"
                     th:if="${products.empty}">
                    Không tìm thấy sản phẩm phù hợp.
                    Vui lòng thử từ khóa hoặc danh mục khác.
                </div>

                <!-- Lưới sản phẩm: giữ cấu trúc Electro -->
                <div class="row">
                    <th:block th:each="product, item : ${products.content}">
                        <div class="col-md-4 col-xs-6">
                            <div class="product">
                                <div class="product-img">
                                    <a th:href="@{/products/{slug}(
                                           slug=${product.slug}
                                       )}">
                                        <img th:if="${!#strings.isEmpty(product.mainImage)}"
                                             th:src="${product.mainImage}"
                                             th:alt="${product.name}"
                                             loading="lazy">

                                        <span class="text-muted"
                                              th:if="${#strings.isEmpty(product.mainImage)}">
                                            Chưa có ảnh
                                        </span>
                                    </a>

                                    <div class="product-label"
                                         th:if="${product.discountPrice != null}">
                                        <span class="sale">Giảm giá</span>
                                    </div>
                                </div>

                                <div class="product-body">
                                    <p class="product-category"
                                       th:text="${product.category.name}">
                                    </p>

                                    <h3 class="product-name">
                                        <a th:href="@{/products/{slug}(
                                               slug=${product.slug}
                                           )}"
                                           th:text="${product.name}"
                                           th:title="${product.name}">
                                        </a>
                                    </h3>

                                    <h4 class="product-price">
                                        <span th:text="${
                                            #numbers.formatDecimal(
                                                product.discountPrice != null
                                                    ? product.discountPrice
                                                    : product.price,
                                                1, 'POINT', 0, 'COMMA'
                                            )
                                        } + ' ₫'">
                                        </span>

                                        <del class="product-old-price"
                                             th:if="${product.discountPrice != null}"
                                             th:text="${
                                                 #numbers.formatDecimal(
                                                     product.price,
                                                     1, 'POINT', 0, 'COMMA'
                                                 )
                                             } + ' ₫'">
                                        </del>
                                    </h4>

                                    <p class="product-stock"
                                       th:classappend="${product.stockQuantity > 0}
                                           ? 'text-success' : 'text-danger'"
                                       th:text="${product.stockQuantity > 0}
                                           ? 'Còn hàng' : 'Hết hàng'">
                                    </p>

                                    <div class="product-btns"><button class="btn btn-default" type="button" th:attr="data-add-product=${product.id}" th:disabled="${product.stockQuantity <= 0}">Thêm vào giỏ</button>
                                        <a th:href="@{/products/{slug}(
                                               slug=${product.slug}
                                           )}">
                                            <i class="fa fa-eye"
                                               aria-hidden="true"></i>
                                            Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="clearfix visible-sm visible-xs"
                             th:if="${item.count % 2 == 0}">
                        </div>

                        <div class="clearfix visible-md visible-lg"
                             th:if="${item.count % 3 == 0}">
                        </div>
                    </th:block>
                </div>

                <!-- Phân trang -->
                <div class="store-filter clearfix">
                    <span class="store-qty"
                          th:if="${!products.empty}"
                          th:text="'Hiển thị '
                              + ${products.number * products.size + 1}
                              + '–'
                              + ${products.number * products.size
                                  + products.numberOfElements}
                              + ' / '
                              + ${products.totalElements}
                              + ' sản phẩm'">
                    </span>

                    <nav th:if="${products.totalPages > 1}"
                         aria-label="Phân trang sản phẩm">
                        <ul class="store-pagination">
                            <li th:if="${products.hasPrevious()}">
                                <a th:href="@{/products(
                                       page=${products.number - 1},
                                       size=${products.size},
                                       keyword=${keyword},
                                       categoryId=${categoryId}
                                   )}"
                                   aria-label="Trang trước">
                                    <i class="fa fa-angle-left"
                                       aria-hidden="true"></i>
                                </a>
                            </li>

                            <li class="active"
                                aria-current="page"
                                th:text="${products.number + 1}">
                            </li>

                            <li th:if="${products.hasNext()}">
                                <a th:href="@{/products(
                                       page=${products.number + 1},
                                       size=${products.size},
                                       keyword=${keyword},
                                       categoryId=${categoryId}
                                   )}"
                                   aria-label="Trang sau">
                                    <i class="fa fa-angle-right"
                                       aria-hidden="true"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

