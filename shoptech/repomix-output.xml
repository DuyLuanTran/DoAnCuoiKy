<file path="src/main/resources/templates/admin/category/form.html">
<!doctype html>
<html
  lang="vi"
  xmlns:th="http://www.thymeleaf.org"
  th:replace="~{fragments/admin-layout :: layout(
          ${formTitle},
          'categories',
          ~{::section}
      )}"
>
  <head>
    <meta charset="UTF-8" />
    <title>Danh mục | ShopTech</title>
  </head>

  <body>
    <section>
      <div
        class="d-flex flex-wrap align-items-center justify-content-between mb-4"
      >
        <h1 class="h3 mb-2 text-gray-800" th:text="${formTitle}">Danh mục</h1>

        <a
          class="btn btn-outline-secondary mb-2"
          th:href="@{/admin/categories}"
        >
          Quay lại danh sách
        </a>
      </div>

      <div class="row">
        <div class="col-xl-8 col-lg-10">
          <div class="card shadow mb-4">
            <div class="card-header py-3">
              <h2 class="h6 m-0 font-weight-bold text-primary">
                Thông tin danh mục
              </h2>
            </div>

            <div class="card-body">
              <form
                th:action="@{${formAction}}"
                th:object="${categoryForm}"
                method="post"
              >
                <!-- Lỗi nghiệp vụ từ service -->
                <div
                  class="alert alert-danger"
                  role="alert"
                  th:if="${#fields.hasGlobalErrors()}"
                >
                  <ul class="mb-0">
                    <li
                      th:each="error : ${#fields.globalErrors()}"
                      th:text="${error}"
                    ></li>
                  </ul>
                </div>

                <div class="form-group">
                  <label for="name">
                    Tên danh mục
                    <span class="text-danger">*</span>
                  </label>

                  <input
                    class="form-control"
                    th:classappend="${#fields.hasErrors('name')}
                                       ? 'is-invalid'"
                    id="name"
                    type="text"
                    th:field="*{name}"
                    maxlength="100"
                    placeholder="Ví dụ: Điện thoại"
                    aria-describedby="nameError"
                    required
                  />

                  <div
                    class="invalid-feedback"
                    id="nameError"
                    th:errors="*{name}"
                  ></div>

                  <small class="form-text text-muted" th:if="${!editing}">
                    Slug được tạo tự động từ tên danh mục.
                  </small>

                  <small class="form-text text-muted" th:if="${editing}">
                    Đổi tên không làm thay đổi slug hiện tại.
                  </small>
                </div>

                <div class="form-group">
                  <label for="description">Mô tả</label>

                  <textarea
                    class="form-control"
                    th:classappend="${#fields.hasErrors('description')}
                                          ? 'is-invalid'"
                    id="description"
                    th:field="*{description}"
                    rows="5"
                    maxlength="5000"
                    placeholder="Nhập mô tả danh mục..."
                    aria-describedby="descriptionError"
                  ></textarea>

                  <div
                    class="invalid-feedback"
                    id="descriptionError"
                    th:errors="*{description}"
                  ></div>
                </div>
                <input type="hidden" th:field="*{iconClass}" />
                <div class="form-group">
                  <div class="custom-control custom-checkbox">
                    <input
                      class="custom-control-input"
                      id="active"
                      type="checkbox"
                      th:field="*{active}"
                    />

                    <label class="custom-control-label" for="active">
                      Bật danh mục
                    </label>
                  </div>

                  <small class="form-text text-muted">
                    Danh mục đang ẩn không xuất hiện trong danh sách danh mục
                    đang bật dành cho khách hàng.
                  </small>
                </div>

                <div class="d-flex justify-content-end flex-wrap mt-4">
                  <a
                    class="btn btn-outline-secondary mr-2 mb-2"
                    th:href="@{/admin/categories}"
                  >
                    Hủy
                  </a>

                  <button
                    class="btn btn-primary mb-2"
                    type="submit"
                    th:text="${editing}
                                        ? 'Lưu thay đổi'
                                        : 'Thêm danh mục'"
                  >
                    Lưu
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>
</file>

<file path="src/main/resources/templates/admin/category/list.html">
<!doctype html>
<html
  lang="vi"
  xmlns:th="http://www.thymeleaf.org"
  th:replace="~{fragments/admin-layout :: layout(
          'Quản lý danh mục',
          'categories',
          ~{::section}
      )}"
>
  <head>
    <meta charset="UTF-8" />
    <title>Quản lý danh mục</title>
  </head>

  <body>
    <section>
      <div
        class="d-flex flex-wrap align-items-center justify-content-between mb-4"
      >
        <h1 class="h3 mb-2 text-gray-800">Quản lý danh mục</h1>

        <a class="btn btn-primary mb-2" th:href="@{/admin/categories/new}">
          <i class="fas fa-plus mr-1" aria-hidden="true"></i>
          Thêm danh mục
        </a>
      </div>

      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h2 class="h6 m-0 font-weight-bold text-primary">
            Danh sách danh mục
          </h2>
        </div>

        <div class="card-body">
          <form th:action="@{/admin/categories}" method="get" class="mb-4">
            <div class="form-row align-items-end">
              <div class="col-md-6 mb-2">
                <label for="keyword">Tên danh mục</label>
                <input
                  class="form-control"
                  id="keyword"
                  name="keyword"
                  type="search"
                  th:value="${keyword}"
                  placeholder="Nhập tên danh mục..."
                />
              </div>

              <div class="col-md-2 mb-2">
                <label for="size">Danh mục mỗi trang</label>
                <select class="form-control" id="size" name="size">
                  <option value="10" th:selected="${categories.size == 10}">
                    10
                  </option>
                  <option value="20" th:selected="${categories.size == 20}">
                    20
                  </option>
                  <option value="50" th:selected="${categories.size == 50}">
                    50
                  </option>
                </select>
              </div>

              <div class="col-md-4 mb-2">
                <button class="btn btn-primary" type="submit">Tìm kiếm</button>

                <a
                  class="btn btn-outline-secondary"
                  th:href="@{/admin/categories}"
                >
                  Xóa lọc
                </a>
              </div>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <caption class="sr-only">
                Danh sách danh mục sản phẩm
              </caption>

              <thead class="thead-light">
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">Tên danh mục</th>
                  <th scope="col">Slug</th>
                  <th scope="col">Trạng thái</th>
                  <th scope="col">Thao tác</th>
                </tr>
              </thead>

              <tbody>
                <tr th:each="category : ${categories.content}">
                  <td th:text="${category.id}"></td>
                  <td th:text="${category.name}"></td>
                  <td th:text="${category.slug}"></td>

                  <td>
                    <span
                      class="badge"
                      th:classappend="${category.isActive}
                                      ? 'badge-success'
                                      : 'badge-secondary'"
                      th:text="${category.isActive}
                                      ? 'Đang bật'
                                      : 'Đang ẩn'"
                    >
                    </span>
                  </td>

                  <td>
                    <div class="d-flex flex-wrap">
                      <a
                        class="btn btn-sm btn-outline-primary mr-2 mb-1"
                        th:href="@{/admin/categories/{id}/edit(
                                       id=${category.id}
                                   )}"
                      >
                        Sửa
                      </a>

                      <form
                        class="mb-1"
                        th:action="@{/admin/categories/{id}/delete(
                                          id=${category.id}
                                      )}"
                        method="post"
                        onsubmit="
                          return confirm('Chuyển danh mục này vào thùng rác?');
                        "
                      >
                        <button
                          class="btn btn-sm btn-outline-danger"
                          type="submit"
                        >
                          Xóa
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>

                <tr th:if="${categories.empty}">
                  <td colspan="5" class="text-center text-muted py-4">
                    Không tìm thấy danh mục phù hợp.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div
            class="d-flex flex-wrap align-items-center justify-content-between"
          >
            <p
              class="text-muted mb-2"
              th:text="'Tổng cộng: ' + ${categories.totalElements}
                       + ' danh mục'"
            ></p>

            <nav
              th:if="${categories.totalPages > 1}"
              aria-label="Phân trang danh mục"
            >
              <ul class="pagination mb-2">
                <li class="page-item" th:if="${categories.hasPrevious()}">
                  <a
                    class="page-link"
                    th:href="@{/admin/categories(
                                   page=${categories.number - 1},
                                   size=${categories.size},
                                   keyword=${keyword}
                               )}"
                  >
                    Trước
                  </a>
                </li>

                <li class="page-item disabled">
                  <span
                    class="page-link"
                    th:text="'Trang '
                                      + ${categories.number + 1}
                                      + ' / '
                                      + ${categories.totalPages}"
                  >
                  </span>
                </li>

                <li class="page-item" th:if="${categories.hasNext()}">
                  <a
                    class="page-link"
                    th:href="@{/admin/categories(
                                   page=${categories.number + 1},
                                   size=${categories.size},
                                   keyword=${keyword}
                               )}"
                  >
                    Sau
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>
</file>

<file path="src/main/resources/templates/admin/product/form.html">
<!doctype html>
<html
  lang="vi"
  xmlns:th="http://www.thymeleaf.org"
  th:replace="~{fragments/admin-layout :: layout(
          ${formTitle},
          'products',
          ~{::section}
      )}"
>
  <head>
    <meta charset="UTF-8" />
    <title>Sản phẩm | ShopTech</title>
  </head>

  <body>
    <section>
      <div
        class="d-flex flex-wrap align-items-center justify-content-between mb-4"
      >
        <h1 class="h3 mb-2 text-gray-800" th:text="${formTitle}">Sản phẩm</h1>

        <a class="btn btn-outline-secondary mb-2" th:href="@{/admin/products}">
          Quay lại danh sách
        </a>
      </div>

      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h2 class="h6 m-0 font-weight-bold text-primary">
            Thông tin sản phẩm
          </h2>
        </div>

        <div class="card-body">
          <form
            th:action="@{${formAction}}"
            th:object="${productForm}"
            method="post"
            enctype="multipart/form-data"
          >
            <div
              class="alert alert-danger"
              role="alert"
              th:if="${#fields.hasGlobalErrors()}"
            >
              <ul class="mb-0">
                <li
                  th:each="error : ${#fields.globalErrors()}"
                  th:text="${error}"
                ></li>
              </ul>
            </div>

            <div
              class="alert alert-warning"
              th:if="${#lists.isEmpty(categories)}"
            >
              Chưa có danh mục khả dụng. Bạn cần tạo hoặc bật danh mục trước khi
              thêm sản phẩm.
              <a th:href="@{/admin/categories}"> Quản lý danh mục </a>
            </div>

            <div class="row">
              <div class="col-lg-8">
                <div class="form-group">
                  <label for="name">
                    Tên sản phẩm
                    <span class="text-danger">*</span>
                  </label>

                  <input
                    class="form-control"
                    th:classappend="${#fields.hasErrors('name')}
                                       ? 'is-invalid'"
                    id="name"
                    type="text"
                    th:field="*{name}"
                    maxlength="255"
                    placeholder="Ví dụ: Laptop Dell Inspiron 15"
                    required
                  />

                  <div class="invalid-feedback" th:errors="*{name}"></div>

                  <small
                    class="form-text text-muted"
                    th:text="${editing}
                                       ? 'Đổi tên không làm thay đổi slug hiện tại.'
                                       : 'Slug được tạo tự động từ tên sản phẩm.'"
                  >
                  </small>
                </div>

                <div class="form-row">
                  <div class="form-group col-md-6">
                    <label for="categoryId">
                      Danh mục
                      <span class="text-danger">*</span>
                    </label>

                    <select
                      class="form-control"
                      th:classappend="${#fields.hasErrors('categoryId')}
                                            ? 'is-invalid'"
                      id="categoryId"
                      th:field="*{categoryId}"
                      required
                    >
                      <option value="">-- Chọn danh mục --</option>

                      <option
                        th:each="category : ${categories}"
                        th:value="${category.id}"
                        th:text="${category.name}
                                                + (${category.isActive}
                                                    ? ''
                                                    : ' (đang ẩn)')"
                      ></option>
                    </select>

                    <div
                      class="invalid-feedback"
                      th:errors="*{categoryId}"
                    ></div>
                  </div>

                  <div class="form-group col-md-6">
                    <label for="sku">Mã sản phẩm (SKU)</label>

                    <input
                      class="form-control"
                      th:classappend="${#fields.hasErrors('sku')}
                                           ? 'is-invalid'"
                      id="sku"
                      type="text"
                      th:field="*{sku}"
                      maxlength="50"
                      placeholder="Ví dụ: LAP-DELL-001"
                    />

                    <div class="invalid-feedback" th:errors="*{sku}"></div>

                    <small class="form-text text-muted">
                      Không bắt buộc. Chỉ dùng chữ không dấu, số, dấu gạch ngang
                      hoặc gạch dưới.
                    </small>
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group col-md-4">
                    <label for="price">
                      Giá gốc (VNĐ)
                      <span class="text-danger">*</span>
                    </label>

                    <input
                      class="form-control"
                      th:classappend="${#fields.hasErrors('price')}
                                           ? 'is-invalid'"
                      id="price"
                      type="number"
                      th:field="*{price}"
                      min="0.01"
                      max="9999999999999.99"
                      step="0.01"
                      placeholder="15000000"
                      required
                    />

                    <div class="invalid-feedback" th:errors="*{price}"></div>
                  </div>

                  <div class="form-group col-md-4">
                    <label for="discountPrice"> Giá khuyến mãi (VNĐ) </label>

                    <input
                      class="form-control"
                      th:classappend="${
                                           #fields.hasErrors('discountPrice')
                                           or #fields.hasErrors('discountPriceValid')
                                       } ? 'is-invalid'"
                      id="discountPrice"
                      type="number"
                      th:field="*{discountPrice}"
                      min="0.01"
                      max="9999999999999.99"
                      step="0.01"
                      placeholder="Để trống nếu không giảm"
                    />

                    <div
                      class="invalid-feedback"
                      th:errors="*{discountPrice}"
                    ></div>

                    <div
                      class="invalid-feedback"
                      th:errors="*{discountPriceValid}"
                    ></div>
                  </div>

                  <div class="form-group col-md-4">
                    <label for="stockQuantity">
                      Số lượng tồn kho
                      <span class="text-danger">*</span>
                    </label>

                    <input
                      class="form-control"
                      th:classappend="${#fields.hasErrors('stockQuantity')}
                                           ? 'is-invalid'"
                      id="stockQuantity"
                      type="number"
                      th:field="*{stockQuantity}"
                      min="0"
                      max="2147483647"
                      step="1"
                      required
                    />

                    <div
                      class="invalid-feedback"
                      th:errors="*{stockQuantity}"
                    ></div>
                  </div>
                </div>

                <div class="form-group">
                  <label for="description">Mô tả sản phẩm</label>

                  <textarea
                    class="form-control"
                    th:classappend="${#fields.hasErrors('description')}
                                          ? 'is-invalid'"
                    id="description"
                    th:field="*{description}"
                    rows="6"
                    maxlength="20000"
                    placeholder="Nhập mô tả sản phẩm..."
                  ></textarea>

                  <div
                    class="invalid-feedback"
                    th:errors="*{description}"
                  ></div>
                </div>

                <div class="form-group">
                  <label for="specifications"> Thông số kỹ thuật </label>

                  <textarea
                    class="form-control"
                    th:classappend="${#fields.hasErrors('specifications')}
                                          ? 'is-invalid'"
                    id="specifications"
                    th:field="*{specifications}"
                    rows="5"
                    maxlength="20000"
                    placeholder="Ví dụ: CPU, RAM, ổ cứng, màn hình..."
                  ></textarea>

                  <div
                    class="invalid-feedback"
                    th:errors="*{specifications}"
                  ></div>
                </div>
              </div>

              <div class="col-lg-4">
                <div class="form-group">
                  <label for="imageFile">
                    Ảnh chính
                    <span class="text-danger" th:if="${!editing}">*</span>
                  </label>

                  <div
                    class="border rounded p-3 mb-3 text-center"
                    th:if="${editing
                                     and !#strings.isEmpty(currentImage)}"
                  >
                    <p class="small text-muted">Ảnh hiện tại</p>

                    <img
                      th:src="${currentImage}"
                      alt="Ảnh sản phẩm hiện tại"
                      class="img-fluid"
                      style="max-height: 220px; object-fit: contain"
                    />
                  </div>

                  <input
                    class="form-control-file"
                    id="imageFile"
                    name="imageFile"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                    th:required="${!editing}"
                  />

                  <small class="form-text text-muted">
                    Chấp nhận JPG, JPEG, PNG hoặc WEBP. Dung lượng tối đa 5 MB.
                  </small>

                  <small class="form-text text-muted" th:if="${editing}">
                    Không chọn ảnh mới để giữ ảnh hiện tại.
                  </small>

                  <small class="form-text text-muted">
                    Nếu lưu không thành công, hãy chọn lại file ảnh trước khi
                    gửi lại.
                  </small>
                </div>

                <div class="form-group mt-4">
                  <div class="custom-control custom-checkbox">
                    <input
                      class="custom-control-input"
                      id="active"
                      type="checkbox"
                      th:field="*{active}"
                    />

                    <label class="custom-control-label" for="active">
                      Bật kinh doanh sản phẩm
                    </label>
                  </div>

                  <small class="form-text text-muted">
                    Bỏ chọn để ẩn sản phẩm khỏi danh sách đang bán dành cho
                    khách hàng.
                  </small>
                </div>
              </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end border-top pt-3">
              <a
                class="btn btn-outline-secondary mr-2 mb-2"
                th:href="@{/admin/products}"
              >
                Hủy
              </a>

              <button
                class="btn btn-primary mb-2"
                type="submit"
                th:disabled="${#lists.isEmpty(categories)}"
                th:text="${editing}
                                ? 'Lưu thay đổi'
                                : 'Thêm sản phẩm'"
              >
                Lưu
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </body>
</html>
</file>

<file path="src/main/resources/templates/admin/product/list.html">
<!doctype html>
<html
  lang="vi"
  xmlns:th="http://www.thymeleaf.org"
  th:replace="~{fragments/admin-layout :: layout(
          'Quản lý sản phẩm',
          'products',
          ~{::section}
      )}"
>
  <head>
    <meta charset="UTF-8" />
    <title>Quản lý sản phẩm | ShopTech</title>
  </head>

  <body>
    <section>
      <div
        class="d-flex flex-wrap align-items-center justify-content-between mb-4"
      >
        <h1 class="h3 mb-2 text-gray-800">Quản lý sản phẩm</h1>

        <a class="btn btn-primary mb-2" th:href="@{/admin/products/new}">
          <i class="fas fa-plus mr-1" aria-hidden="true"></i>
          Thêm sản phẩm
        </a>
      </div>

      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h2 class="h6 m-0 font-weight-bold text-primary">
            Danh sách sản phẩm
          </h2>
        </div>

        <div class="card-body">
          <!-- Tìm kiếm và lọc -->
          <form class="mb-4" th:action="@{/admin/products}" method="get">
            <div class="form-row align-items-end">
              <div class="col-lg-4 mb-2">
                <label for="keyword">Tên hoặc mã sản phẩm</label>
                <input
                  class="form-control"
                  id="keyword"
                  name="keyword"
                  type="search"
                  th:value="${keyword}"
                  placeholder="Nhập tên hoặc mã sản phẩm..."
                />
              </div>

              <div class="col-lg-3 mb-2">
                <label for="categoryId">Danh mục</label>
                <select class="form-control" id="categoryId" name="categoryId">
                  <option value="">Tất cả danh mục</option>
                  <option
                    th:each="category : ${categories}"
                    th:value="${category.id}"
                    th:text="${category.name}"
                    th:selected="${category.id == categoryId}"
                  ></option>
                </select>
              </div>

              <div class="col-lg-2 mb-2">
                <label for="size">Sản phẩm mỗi trang</label>
                <select class="form-control" id="size" name="size">
                  <option value="10" th:selected="${products.size == 10}">
                    10
                  </option>
                  <option value="20" th:selected="${products.size == 20}">
                    20
                  </option>
                  <option value="50" th:selected="${products.size == 50}">
                    50
                  </option>
                </select>
              </div>

              <div class="col-lg-3 mb-2">
                <button class="btn btn-primary" type="submit">Tìm kiếm</button>

                <a
                  class="btn btn-outline-secondary"
                  th:href="@{/admin/products}"
                >
                  Xóa lọc
                </a>
              </div>
            </div>
          </form>

          <!-- Bảng sản phẩm -->
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <caption class="sr-only">
                Danh sách sản phẩm
              </caption>

              <thead class="thead-light">
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">Ảnh</th>
                  <th scope="col">Sản phẩm</th>
                  <th scope="col">Danh mục</th>
                  <th scope="col">Giá</th>
                  <th scope="col">Tồn kho</th>
                  <th scope="col">Trạng thái</th>
                  <th scope="col">Thao tác</th>
                </tr>
              </thead>

              <tbody>
                <tr th:each="product : ${products.content}">
                  <td th:text="${product.id}"></td>

                  <td>
                    <img
                      th:if="${!#strings.isEmpty(product.mainImage)}"
                      th:src="${product.mainImage}"
                      th:alt="${product.name}"
                      width="64"
                      height="64"
                      loading="lazy"
                      class="rounded"
                      style="object-fit: contain"
                    />

                    <span
                      class="text-muted small"
                      th:if="${#strings.isEmpty(product.mainImage)}"
                    >
                      Chưa có ảnh
                    </span>
                  </td>

                  <td>
                    <strong th:text="${product.name}"></strong>

                    <small
                      class="d-block text-muted"
                      th:text="'Mã: ' + ${
                                       #strings.isEmpty(product.sku)
                                       ? 'Chưa có'
                                       : product.sku
                                   }"
                    >
                    </small>
                  </td>

                  <td th:text="${product.category.name}"></td>

                  <td class="text-nowrap">
                    <th:block th:if="${product.discountPrice != null}">
                      <strong
                        class="d-block text-danger"
                        th:text="${
                                            #numbers.formatDecimal(
                                                product.discountPrice,
                                                1,
                                                'POINT',
                                                0,
                                                'COMMA'
                                            )
                                        } + ' ₫'"
                      >
                      </strong>

                      <del
                        class="small text-muted"
                        th:text="${
                                         #numbers.formatDecimal(
                                             product.price,
                                             1,
                                             'POINT',
                                             0,
                                             'COMMA'
                                         )
                                     } + ' ₫'"
                      >
                      </del>
                    </th:block>

                    <strong
                      th:if="${product.discountPrice == null}"
                      th:text="${
                                        #numbers.formatDecimal(
                                            product.price,
                                            1,
                                            'POINT',
                                            0,
                                            'COMMA'
                                        )
                                    } + ' ₫'"
                    >
                    </strong>
                  </td>

                  <td>
                    <span
                      th:text="${product.stockQuantity}"
                      th:classappend="${product.stockQuantity == 0}
                                      ? 'text-danger font-weight-bold'"
                    >
                    </span>
                  </td>

                  <td>
                    <span
                      class="badge"
                      th:classappend="${product.isActive}
                                      ? 'badge-success'
                                      : 'badge-secondary'"
                      th:text="${product.isActive}
                                      ? 'Đang bật'
                                      : 'Đang ẩn'"
                    >
                    </span>
                  </td>

                  <td>
                    <div class="d-flex flex-wrap">
                      <a
                        class="btn btn-sm btn-outline-primary mr-2 mb-1"
                        th:href="@{/admin/products/{id}/edit(
                                       id=${product.id}
                                   )}"
                      >
                        Sửa
                      </a>

                      <form
                        class="mb-1"
                        th:action="@{/admin/products/{id}/delete(
                                          id=${product.id}
                                      )}"
                        method="post"
                        onsubmit="
                          return confirm('Chuyển sản phẩm này vào thùng rác?');
                        "
                      >
                        <button
                          class="btn btn-sm btn-outline-danger"
                          type="submit"
                        >
                          Xóa
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>

                <tr th:if="${products.empty}">
                  <td colspan="8" class="text-center text-muted py-4">
                    Không tìm thấy sản phẩm phù hợp.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Phân trang -->
          <div
            class="d-flex flex-wrap align-items-center justify-content-between"
          >
            <p
              class="text-muted mb-2"
              th:text="'Tổng cộng: ' + ${products.totalElements}
                       + ' sản phẩm'"
            ></p>

            <nav
              th:if="${products.totalPages > 1}"
              aria-label="Phân trang sản phẩm"
            >
              <ul class="pagination mb-2">
                <li class="page-item" th:if="${products.hasPrevious()}">
                  <a
                    class="page-link"
                    th:href="@{/admin/products(
                                   page=${products.number - 1},
                                   size=${products.size},
                                   keyword=${keyword},
                                   categoryId=${categoryId}
                               )}"
                  >
                    Trước
                  </a>
                </li>

                <li class="page-item disabled">
                  <span
                    class="page-link"
                    th:text="'Trang '
                                      + ${products.number + 1}
                                      + ' / '
                                      + ${products.totalPages}"
                  >
                  </span>
                </li>

                <li class="page-item" th:if="${products.hasNext()}">
                  <a
                    class="page-link"
                    th:href="@{/admin/products(
                                   page=${products.number + 1},
                                   size=${products.size},
                                   keyword=${keyword},
                                   categoryId=${categoryId}
                               )}"
                  >
                    Sau
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>
</file>

<file path="src/main/resources/templates/admin/user/form.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title th:text="${formTitle} + ' | ShopTech'"></title>
    <link rel="stylesheet" th:href="@{/admin/css/sb-admin-2.min.css}">
    <link rel="stylesheet" th:href="@{/admin/css/user-management.css}">
</head>
<body class="admin-page">
<header class="topbar">
    <a class="brand" th:href="@{/admin/users}">SHOPTECH <span>Quản trị</span></a>
    <nav><a class="active" th:href="@{/admin/users}">Người dùng</a><a th:href="@{/admin/users/trash}">Thùng rác</a><a th:href="@{/account}">Tài khoản</a></nav>
    <form th:action="@{/logout}" method="post"><button class="button secondary" type="submit">Đăng xuất</button></form>
</header>
<main class="page-container narrow-container">
    <div class="page-heading">
        <div><p class="eyebrow">QUẢN TRỊ HỆ THỐNG</p><h1 th:text="${formTitle}"></h1><p class="muted">Thông tin tài khoản được lưu trong hệ thống ShopTech.</p></div>
    </div>
    <section class="panel form-panel">
        <div class="notice error" th:if="${#fields.hasGlobalErrors()}">
            <p th:each="error : ${#fields.globalErrors()}" th:text="${error}"></p>
        </div>
        <form th:if="${!editing}" th:action="@{${formAction}}" th:object="${registerForm}" method="post">
            <div class="form-grid">
                <div class="field"><label for="fullName">Họ và tên</label><input id="fullName" th:field="*{fullName}" required><small class="field-error" th:errors="*{fullName}"></small></div>
                <div class="field"><label for="username">Tên đăng nhập</label><input id="username" th:field="*{username}" minlength="3" maxlength="50" required><small class="field-error" th:errors="*{username}"></small></div>
                <div class="field"><label for="email">Email</label><input id="email" th:field="*{email}" type="email" required><small class="field-error" th:errors="*{email}"></small></div>
                <div class="field"><label for="phoneNumber">Số điện thoại</label><input id="phoneNumber" th:field="*{phoneNumber}" type="tel"><small class="field-error" th:errors="*{phoneNumber}"></small></div>
                <div class="field field-full"><label for="address">Địa chỉ</label><input id="address" th:field="*{address}" maxlength="255"><small class="field-error" th:errors="*{address}"></small></div>
                <div class="field field-full"><label for="password">Mật khẩu (ít nhất 6 ký tự)</label><input id="password" th:field="*{password}" type="password" minlength="6" required><small class="field-error" th:errors="*{password}"></small></div>
            </div>
            <div class="form-actions"><a class="button secondary" th:href="@{/admin/users}">Hủy</a><button class="button primary" type="submit">Tạo tài khoản</button></div>
        </form>
        <form th:if="${editing}" th:action="@{${formAction}}" th:object="${userForm}" method="post">
            <div class="form-grid">
                <div class="field"><label for="fullName">Họ và tên</label><input id="fullName" th:field="*{fullName}" required><small class="field-error" th:errors="*{fullName}"></small></div>
                <div class="field"><label for="username">Tên đăng nhập</label><input id="username" th:field="*{username}" minlength="3" maxlength="50" required><small class="field-error" th:errors="*{username}"></small></div>
                <div class="field"><label for="email">Email</label><input id="email" th:field="*{email}" type="email" required><small class="field-error" th:errors="*{email}"></small></div>
                <div class="field"><label for="phoneNumber">Số điện thoại</label><input id="phoneNumber" th:field="*{phoneNumber}" type="tel"><small class="field-error" th:errors="*{phoneNumber}"></small></div>
                <div class="field field-full"><label for="address">Địa chỉ</label><input id="address" th:field="*{address}" maxlength="255"><small class="field-error" th:errors="*{address}"></small></div>
                <div class="field field-full"><label for="password">Mật khẩu mới (để trống nếu không đổi)</label><input id="password" th:field="*{password}" type="password" minlength="6" autocomplete="new-password"><small class="field-error" th:errors="*{password}"></small></div>
            </div>
            <div class="form-actions"><a class="button secondary" th:href="@{/admin/users}">Hủy</a><button class="button primary" type="submit">Lưu thay đổi</button></div>
        </form>
    </section>
</main>
</body>
</html>
</file>

<file path="src/main/resources/templates/admin/user/list.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quản lý người dùng | ShopTech</title>
    <link rel="stylesheet" th:href="@{/admin/css/sb-admin-2.min.css}">
    <link rel="stylesheet" th:href="@{/admin/css/user-management.css}">
</head>
<body class="admin-page">
<header class="topbar">
    <a class="brand" th:href="@{/admin/users}">SHOPTECH <span>Quản trị</span></a>
    <nav><a class="active" th:href="@{/admin/users}">Người dùng</a><a th:href="@{/admin/users/trash}">Thùng rác</a><a th:href="@{/account}">Tài khoản</a></nav>
    <form th:action="@{/logout}" method="post"><button class="button secondary" type="submit">Đăng xuất</button></form>
</header>
<main class="page-container">
    <div class="page-heading">
        <div><p class="eyebrow">QUẢN TRỊ HỆ THỐNG</p><h1>Quản lý người dùng</h1><p class="muted">Tìm kiếm, cập nhật trạng thái và quản lý tài khoản khách hàng.</p></div>
        <a class="button primary" th:href="@{/admin/users/new}">+ Tạo tài khoản</a>
    </div>

    <div class="notice success" th:if="${successMessage}" th:text="${successMessage}"></div>
    <div class="notice error" th:if="${errorMessage}" th:text="${errorMessage}"></div>

    <section class="panel">
        <form class="search-form" th:action="@{/admin/users}" method="get">
            <label class="sr-only" for="keyword">Tìm theo tên, email hoặc tên đăng nhập</label>
            <input id="keyword" name="keyword" th:value="${keyword}" placeholder="Tìm theo tên, email hoặc tên đăng nhập">
            <button class="button primary" type="submit">Tìm kiếm</button>
            <a class="button secondary" th:href="@{/admin/users}">Xóa lọc</a>
        </form>
        <div class="table-scroll">
            <table>
                <thead><tr><th>ID</th><th>Người dùng</th><th>Email / Điện thoại</th><th>Vai trò</th><th>Trạng thái</th><th class="actions-heading">Thao tác</th></tr></thead>
                <tbody>
                <tr th:each="user : ${users.content}">
                    <td th:text="${user.id}"></td>
                    <td><strong th:text="${user.fullName}"></strong><span class="subtext" th:text="${user.username}"></span></td>
                    <td><span th:text="${user.email}"></span><span class="subtext" th:text="${user.phoneNumber ?: 'Chưa cập nhật'}"></span></td>
                    <td><span class="role-chip" th:each="role : ${user.roles}" th:text="${role.name == 'ROLE_ADMIN' ? 'Quản trị' : 'Khách hàng'}"></span></td>
                    <td><span class="status" th:classappend="${user.isActive} ? ' status-active' : ' status-locked'" th:text="${user.isActive} ? 'Hoạt động' : 'Đã khóa'"></span></td>
                    <td class="actions">
                        <a class="button small secondary" th:href="@{/admin/users/{id}/edit(id=${user.id})}">Sửa</a>
                        <form th:action="@{/admin/users/{id}/toggle-active(id=${user.id})}" method="post">
                            <button class="button small secondary" type="submit" th:text="${user.isActive} ? 'Khóa' : 'Mở khóa'"></button>
                        </form>
                        <form th:action="@{/admin/users/{id}/delete(id=${user.id})}" method="post" onsubmit="return confirm('Chuyển tài khoản này vào thùng rác?')">
                            <button class="button small danger" type="submit">Xóa</button>
                        </form>
                    </td>
                </tr>
                <tr th:if="${users.empty}"><td class="empty-cell" colspan="6">Không tìm thấy người dùng phù hợp.</td></tr>
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span th:text="${users.totalElements} + ' tài khoản'"></span>
            <div class="pagination" th:if="${users.totalPages > 1}">
                <a th:if="${users.hasPrevious()}" th:href="@{/admin/users(page=${users.number - 1},size=${users.size},keyword=${keyword})}">Trước</a>
                <a th:each="pageNumber : ${#numbers.sequence(0, users.totalPages - 1)}"
                   th:href="@{/admin/users(page=${pageNumber},size=${users.size},keyword=${keyword})}"
                   th:classappend="${pageNumber == users.number} ? ' selected'"
                   th:text="${pageNumber + 1}"></a>
                <a th:if="${users.hasNext()}" th:href="@{/admin/users(page=${users.number + 1},size=${users.size},keyword=${keyword})}">Sau</a>
            </div>
        </div>
    </section>
</main>
</body>
</html>
</file>

<file path="src/main/resources/templates/admin/user/trash.html">
<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Thùng rác người dùng | ShopTech</title>
    <link rel="stylesheet" th:href="@{/admin/css/sb-admin-2.min.css}">
    <link rel="stylesheet" th:href="@{/admin/css/user-management.css}">
</head>
<body class="admin-page">
<header class="topbar">
    <a class="brand" th:href="@{/admin/users}">SHOPTECH <span>Quản trị</span></a>
    <nav><a th:href="@{/admin/users}">Người dùng</a><a class="active" th:href="@{/admin/users/trash}">Thùng rác</a><a th:href="@{/account}">Tài khoản</a></nav>
    <form th:action="@{/logout}" method="post"><button class="button secondary" type="submit">Đăng xuất</button></form>
</header>
<main class="page-container">
    <div class="page-heading">
        <div><p class="eyebrow">QUẢN TRỊ HỆ THỐNG</p><h1>Thùng rác người dùng</h1><p class="muted">Có thể khôi phục tài khoản hoặc xóa vĩnh viễn.</p></div>
        <a class="button secondary" th:href="@{/admin/users}">← Danh sách người dùng</a>
    </div>

    <div class="notice success" th:if="${successMessage}" th:text="${successMessage}"></div>
    <div class="notice error" th:if="${errorMessage}" th:text="${errorMessage}"></div>
    <section class="panel">
        <div class="table-scroll">
            <table>
                <thead><tr><th>ID</th><th>Người dùng</th><th>Email</th><th>Ngày xóa</th><th class="actions-heading">Thao tác</th></tr></thead>
                <tbody>
                <tr th:each="user : ${trashUsers.content}">
                    <td th:text="${user.id}"></td>
                    <td><strong th:text="${user.fullName}"></strong><span class="subtext" th:text="${user.username}"></span></td>
                    <td th:text="${user.email}"></td>
                    <td th:text="${user.deletedAt != null ? #temporals.format(user.deletedAt, 'dd/MM/yyyy HH:mm') : '—'}"></td>
                    <td class="actions">
                        <form th:action="@{/admin/users/{id}/restore(id=${user.id})}" method="post">
                            <button class="button small primary" type="submit">Khôi phục</button>
                        </form>
                        <form th:action="@{/admin/users/{id}/force-delete(id=${user.id})}" method="post" onsubmit="return confirm('Xóa vĩnh viễn tài khoản này? Thao tác không thể hoàn tác.')">
                            <button class="button small danger" type="submit">Xóa vĩnh viễn</button>
                        </form>
                    </td>
                </tr>
                <tr th:if="${trashUsers.empty}"><td class="empty-cell" colspan="5">Thùng rác đang trống.</td></tr>
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span th:text="${trashUsers.totalElements} + ' tài khoản'"></span>
            <div class="pagination" th:if="${trashUsers.totalPages > 1}">
                <a th:if="${trashUsers.hasPrevious()}" th:href="@{/admin/users/trash(page=${trashUsers.number - 1},size=${trashUsers.size})}">Trước</a>
                <a th:each="pageNumber : ${#numbers.sequence(0, trashUsers.totalPages - 1)}"
                   th:href="@{/admin/users/trash(page=${pageNumber},size=${trashUsers.size})}"
                   th:classappend="${pageNumber == trashUsers.number} ? ' selected'"
                   th:text="${pageNumber + 1}"></a>
                <a th:if="${trashUsers.hasNext()}" th:href="@{/admin/users/trash(page=${trashUsers.number + 1},size=${trashUsers.size})}">Sau</a>
            </div>
        </div>
    </section>
</main>
</body>
</html>
</file>

