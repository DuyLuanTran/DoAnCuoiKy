            model.addAttribute(
                    "productForm",
                    productService.getFormById(id)
            );
            prepareEditForm(model, id);

            return "admin/product/form";
        } catch (IllegalArgumentException exception) {
            redirectAttributes.addFlashAttribute(
                    "errorMessage",
