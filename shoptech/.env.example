# ==========================================================
# ENV TEMPLATE CHO SHOPTECH (Sao chép thành file .env hoặc set biến môi trường)
# ==========================================================

# 1. Supabase Database Configuration
# Lấy từ: Supabase Dashboard -> Project Settings -> Database -> Connection string
SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_actual_supabase_db_password

# 2. Cloudinary Configuration (Upload ảnh sản phẩm)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. JWT (tạo JWT_SECRET ngẫu nhiên; không dùng một key mẫu có sẵn)
# PowerShell: $b=New-Object byte[] 32; $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_VALIDITY_MINUTES=20
COOKIE_SECURE=false

# 4. SMTP Gmail (dùng Google App Password, không dùng mật khẩu tài khoản)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=
APP_PUBLIC_BASE_URL=http://localhost:8080
