# ==========================================================
# ENV TEMPLATE CHO SHOPTECH (Sao chép thành file .env hoặc set biến môi trường)
# ==========================================================

# 1. Supabase Database Configuration
# Lấy từ: Supabase Dashboard -> Project Settings -> Database -> Connection string
DB_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_actual_supabase_db_password

# 2. Cloudinary Configuration (Upload ảnh sản phẩm)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. JWT Secret (Cho chức năng Auth của Người 1)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
